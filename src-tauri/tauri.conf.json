{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quota Float Ubuntu",
  "version": "0.1.9",
  "identifier": "app.quotafloat.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "widget",
        "title": "Quota Float · Ubuntu 26.04",
        "width": 320,
        "height": 320,
        "minWidth": 100,
        "minHeight": 100,
        "maxWidth": 320,
        "maxHeight": 320,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": false,
        "shadow": false,
        "visible": false
      }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; img-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "targets": "deb",
    "category": "Utility",
    "shortDescription": "Codex quota at a glance for Ubuntu 26.04",
    "longDescription": "A lightweight, always-on-top Ubuntu desktop widget for Codex usage limits.",
    "copyright": "Copyright Quota Float contributors",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 (>= 2.52)",
          "libgtk-3-0t64",
          "libayatana-appindicator3-1",
          "xwayland"
        ]
      }
    }
  }
}
