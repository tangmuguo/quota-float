{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quota Float Ubuntu",
  "app": {
    "windows": [
      {
        "label": "widget",
        "title": "Quota Float · Ubuntu 26.04",
        "width": 320,
        "height": 320,
        "minWidth": 100,
        "minHeight": 100,
        "maxWidth": 320,
        "maxHeight": 320,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": false,
        "visibleOnAllWorkspaces": false,
        "skipTaskbar": true,
        "shadow": false,
        "visible": false
      }
    ]
  },
  "bundle": {
    "targets": "deb",
    "shortDescription": "Codex quota at a glance for Ubuntu 26.04",
    "longDescription": "A lightweight Ubuntu widget anchored to the ChatGPT desktop window for Codex usage limits.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 (>= 2.52)",
          "libgtk-3-0t64",
          "libayatana-appindicator3-1",
          "gnome-shell (>= 48)"
        ],
        "files": {
          "/usr/share/gnome-shell/extensions/quota-float-anchor@quotafloat.app/metadata.json": "gnome-extension/quota-float-anchor@quotafloat.app/metadata.json",
          "/usr/share/gnome-shell/extensions/quota-float-anchor@quotafloat.app/extension.js": "gnome-extension/quota-float-anchor@quotafloat.app/extension.js",
          "/usr/share/gnome-shell/extensions/quota-float-anchor@quotafloat.app/anchor.js": "gnome-extension/quota-float-anchor@quotafloat.app/anchor.js"
        }
      }
    }
  }
}
